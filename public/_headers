/data/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Access-Control-Allow-Headers: Content-Type

/data/manifest.json
  Cache-Control: no-store

/data/collections/*
  Cache-Control: public, max-age=600, s-maxage=600, must-revalidate

/data/locations/*
  Cache-Control: public, max-age=600, s-maxage=600, must-revalidate
